# Form service that receives contact/partner enquiries as JSON (inlined at build time)
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX (analytics stay off when empty)
NEXT_PUBLIC_GA_ID=
# Apps Script web-app URL of the Google Sheet admin (cms/README.md); empty = no Sheet content
CMS_ENDPOINT=
